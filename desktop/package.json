{
  "name": "forthmark",
  "version": "0.1.0",
  "private": true,
  "description": "Forthmark desktop shell for Windows: tray, panel windows, notifications",
  "author": "Cat0513",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/icon.test.js",
    "python": "node scripts/fetch-python.js",
    "dist": "npm run python && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "app.forthmark.desktop",
    "productName": "Forthmark",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "trayicon.js"
    ],
    "extraResources": [
      {
        "from": "python-runtime",
        "to": "python"
      },
      {
        "from": "..",
        "to": "kit",
        "filter": [
          "tools/forthmark.py",
          "tools/fmshared.py",
          "hooks/*.py",
          "commands/**/*",
          "templates/**/*",
          "vendor/**/*",
          "schema/**/*",
          "LICENSE"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Forthmark-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0",
    "playwright-core": "1.64.1"
  }
}
